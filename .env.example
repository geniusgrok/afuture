# CTP 密钥只通过环境变量注入，禁止提交真实值。
AFUTURE_CTP_USER=
AFUTURE_CTP_PASSWORD=
AFUTURE_CTP_BROKER=
AFUTURE_CTP_APP_ID=
AFUTURE_CTP_AUTH_CODE=
# Stress-90 连接柜台时必须显式绑定预期 AccountID/CurrencyID；
# 柜台能提供投资者或投资单元身份时也应配置后两项。
AFUTURE_CTP_ACCOUNT_ID=
AFUTURE_CTP_CURRENCY_ID=CNY
AFUTURE_CTP_INVESTOR_ID=
AFUTURE_CTP_INVEST_UNIT_ID=

# 只有连接生产柜台时才设置。
AFUTURE_LIVE_ACK=I_UNDERSTAND_FUTURES_RISK
# 只有人工核验真实持仓并执行 recover-state 时才设置。
AFUTURE_RECOVERY_ACK=I_VERIFIED_CTP_POSITIONS
