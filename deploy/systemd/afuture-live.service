[Unit]
Description=afuture live trading process
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=<AFUTURE_WORKDIR>
EnvironmentFile=<AFUTURE_ENV_FILE>
UMask=0077
ExecStart=<AFUTURE_VENV>/bin/afuture live --config <AFUTURE_CONFIG> <AFUTURE_LIVE_CONFIRM_FLAG>
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=75
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
